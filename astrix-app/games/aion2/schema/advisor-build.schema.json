{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/astrix-app/games/aion2/schema/advisor-build.schema.json",
  "title": "AION 2 Ascent Plan role build",
  "description": "One record in data/advisor/builds/<class>.json. Fields cite sources with refs; each ref is a community-guide source in provenance. A role with no published build has status pending and a pending build field.",
  "type": "object",
  "required": ["id", "class", "role", "main", "label", "summary", "status", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z]+-(tank|healer|support|dps)$" },
    "class": { "enum": ["Gladiator", "Templar", "Assassin", "Ranger", "Sorcerer", "Spiritmaster", "Cleric", "Chanter"] },
    "role": { "enum": ["tank", "healer", "support", "dps"] },
    "main": { "type": "boolean" },
    "label": { "type": "string", "minLength": 1 },
    "beginner": { "enum": ["very high", "high", "medium", "low"] },
    "summary": { "type": "string", "minLength": 1 },
    "status": { "enum": ["sourced", "partial", "pending"] },
    "roleRefs": { "$ref": "#/$defs/refs" },
    "build": { "$ref": "../../../platform/contracts/pending.schema.json" },
    "coreSkills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "priority", "target", "why", "refs"],
        "properties": {
          "name": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "target": { "type": "string" },
          "why": { "type": "string" },
          "refs": { "$ref": "#/$defs/refs" }
        }
      }
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill", "picks"],
        "properties": {
          "skill": { "type": "string" },
          "picks": { "type": "array", "items": { "type": "object", "required": ["skillLevel", "pick", "refs"], "properties": { "skillLevel": { "enum": [8, 12, 16] }, "pick": { "type": "string" }, "refs": { "$ref": "#/$defs/refs" } } } }
        }
      }
    },
    "stigmas": {
      "oneOf": [
        { "$ref": "../../../platform/contracts/pending.schema.json" },
        {
          "type": "object",
          "required": ["slots", "alternatives", "confidence", "refs"],
          "properties": {
            "slots": { "type": "array", "maxItems": 4, "items": { "type": "object", "required": ["slotLevel", "name"], "properties": { "slotLevel": { "enum": [22, 27, 32, 37] }, "name": { "type": "string" } } } },
            "alternatives": { "type": "array" },
            "confidence": { "enum": ["consensus", "top-player data", "single-source"] },
            "note": { "type": "string" },
            "refs": { "$ref": "#/$defs/refs" }
          }
        }
      ]
    },
    "daevanion": { "oneOf": [{ "$ref": "../../../platform/contracts/pending.schema.json" }, { "type": "object", "required": ["priorities", "refs"] }] },
    "stats": { "oneOf": [{ "$ref": "../../../platform/contracts/pending.schema.json" }, { "type": "object", "required": ["order", "refs"] }] },
    "rotation": { "oneOf": [{ "$ref": "../../../platform/contracts/pending.schema.json" }, { "type": "object", "required": ["steps", "refs"] }] },
    "levelNotes": { "type": "array" },
    "provenance": { "$ref": "../../../platform/contracts/provenance.schema.json" }
  },
  "$defs": {
    "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
  }
}
