{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/astrix-app/games/aion2/schema/character.schema.json",
  "title": "AION 2 character",
  "description": "One normalised character, the same shape for every class. Built from the public armory by engine/armory-adapter.mjs. A value the armory does not send is pending, never guessed.",
  "type": "object",
  "required": [
    "profile",
    "gear",
    "accessorySlots",
    "stats",
    "skills",
    "daevanion",
    "pet",
    "wings",
    "source",
    "arcana",
    "titles",
    "appearance"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "object",
      "required": [
        "name",
        "class",
        "level",
        "raceName",
        "server",
        "title",
        "combatPower",
        "itemLevel",
        "characterId",
        "portrait"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "raceName": {
          "enum": [
            "Elyos",
            "Asmodian"
          ]
        },
        "raceId": {
          "enum": [
            1,
            2
          ]
        },
        "server": {
          "type": "object",
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "titleGrade": {
          "type": [
            "string",
            "null"
          ]
        },
        "titleEffects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "combatPower": {
          "type": "integer",
          "minimum": 0
        },
        "itemLevel": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "$ref": "../../../platform/contracts/pending.schema.json"
            }
          ]
        },
        "characterId": {
          "type": "string",
          "minLength": 1
        },
        "portrait": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        },
        "legion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "The legion name (profile.regionName in the data). null when the Daeva has no legion (the data sends an empty string)."
        },
        "titleId": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The id of the title the Daeva shows (cosmetic)."
        }
      }
    },
    "gear": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "slot",
              "slotPos",
              "empty"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "slotPos": {
                "type": "integer"
              },
              "empty": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "slot",
              "slotPos",
              "empty",
              "itemId",
              "name",
              "grade",
              "enchant",
              "maxEnchant",
              "manastoneSlots",
              "icon"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "slotPos": {
                "type": "integer"
              },
              "empty": {
                "const": false
              },
              "itemId": {
                "type": "integer"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "grade": {
                "type": "string",
                "minLength": 1
              },
              "enchant": {
                "type": "integer",
                "minimum": 0
              },
              "maxEnchant": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "../../../platform/contracts/pending.schema.json"
                  }
                ]
              },
              "manastoneSlots": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "../../../platform/contracts/pending.schema.json"
                  }
                ]
              },
              "icon": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://"
              },
              "exceed": {
                "type": "integer",
                "minimum": 0,
                "description": "exceedLevel from the equipment list; 0 when none."
              }
            }
          }
        ]
      }
    },
    "accessorySlots": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "slot",
                  "slotPos",
                  "empty"
                ],
                "additionalProperties": false,
                "properties": {
                  "slot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slotPos": {
                    "type": "integer"
                  },
                  "empty": {
                    "const": true
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "slot",
                  "slotPos",
                  "empty",
                  "itemId",
                  "name",
                  "grade",
                  "enchant",
                  "maxEnchant",
                  "manastoneSlots",
                  "icon"
                ],
                "additionalProperties": false,
                "properties": {
                  "slot": {
                    "type": "string",
                    "minLength": 1
                  },
                  "slotPos": {
                    "type": "integer"
                  },
                  "empty": {
                    "const": false
                  },
                  "itemId": {
                    "type": "integer"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "grade": {
                    "type": "string",
                    "minLength": 1
                  },
                  "enchant": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "maxEnchant": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "$ref": "../../../platform/contracts/pending.schema.json"
                      }
                    ]
                  },
                  "manastoneSlots": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "$ref": "../../../platform/contracts/pending.schema.json"
                      }
                    ]
                  },
                  "icon": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^https://"
                  }
                }
              }
            ]
          }
        },
        {
          "$ref": "../../../platform/contracts/pending.schema.json"
        }
      ]
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "needLevel",
          "skillLevel",
          "acquired",
          "equipped",
          "icon"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "Active",
              "Passive",
              "Dp"
            ]
          },
          "needLevel": {
            "type": "integer",
            "minimum": 0
          },
          "skillLevel": {
            "type": "integer",
            "minimum": 0
          },
          "acquired": {
            "type": "boolean"
          },
          "equipped": {
            "type": "boolean"
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          }
        }
      }
    },
    "daevanion": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "open",
          "nodesTaken",
          "nodesTotal",
          "icon"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "open": {
            "type": "boolean"
          },
          "nodesTaken": {
            "type": "integer",
            "minimum": 0
          },
          "nodesTotal": {
            "type": "integer",
            "minimum": 0
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "nodeId",
                "boardId",
                "row",
                "col",
                "type",
                "grade",
                "name",
                "taken",
                "effects"
              ],
              "additionalProperties": false,
              "properties": {
                "nodeId": {
                  "type": "integer"
                },
                "boardId": {
                  "type": "integer"
                },
                "row": {
                  "type": "integer"
                },
                "col": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "grade": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string"
                },
                "taken": {
                  "type": "boolean"
                },
                "effects": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "icon": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://"
          },
          "percent": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "openPercent: the official page's percent complete for the board."
          }
        }
      }
    },
    "pet": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "name",
            "level",
            "icon"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "level": {
              "type": "integer",
              "minimum": 0
            },
            "icon": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://"
            }
          }
        },
        {
          "$ref": "../../../platform/contracts/pending.schema.json"
        }
      ]
    },
    "wings": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "name",
            "grade",
            "enchant",
            "icon"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "grade": {
              "type": "string",
              "minLength": 1
            },
            "enchant": {
              "type": "integer",
              "minimum": 0
            },
            "icon": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://"
            }
          }
        },
        {
          "$ref": "../../../platform/contracts/pending.schema.json"
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "region",
        "capturedOn"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "armory"
        },
        "region": {
          "enum": [
            "naw",
            "nae",
            "eu",
            "la",
            "as"
          ]
        },
        "capturedOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "value",
          "kind",
          "effects"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "kind": {
            "type": "string",
            "enum": [
              "main",
              "deity"
            ],
            "description": "main: the six main stats; deity: the ten deity stats."
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The official statSecondList: what these points give, in the game's words."
          }
        }
      }
    },
    "arcana": {
      "description": "The five Arcana slots (Arcana1 to Arcana5), each a worn gear entry or empty.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "slot",
              "slotPos",
              "empty"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "slotPos": {
                "type": "integer"
              },
              "empty": {
                "const": true
              }
            }
          },
          {
            "type": "object",
            "required": [
              "slot",
              "slotPos",
              "empty",
              "itemId",
              "name",
              "grade",
              "enchant",
              "maxEnchant",
              "manastoneSlots",
              "icon"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "slotPos": {
                "type": "integer"
              },
              "empty": {
                "const": false
              },
              "itemId": {
                "type": "integer"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "grade": {
                "type": "string",
                "minLength": 1
              },
              "enchant": {
                "type": "integer",
                "minimum": 0
              },
              "maxEnchant": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "../../../platform/contracts/pending.schema.json"
                  }
                ]
              },
              "manastoneSlots": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "$ref": "../../../platform/contracts/pending.schema.json"
                  }
                ]
              },
              "icon": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://"
              },
              "exceed": {
                "type": "integer",
                "minimum": 0,
                "description": "exceedLevel from the equipment list; 0 when none."
              }
            }
          }
        ]
      }
    },
    "titles": {
      "description": "Titles (info.title): owned of total, and per category (Attack, Defense, Etc) owned of total and the title worn there with its two effect lists. Pending when the data has no title block.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "owned",
            "total",
            "categories"
          ],
          "additionalProperties": false,
          "properties": {
            "owned": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "code",
                  "owned",
                  "total",
                  "percent",
                  "worn"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "enum": [
                      "attack",
                      "defense",
                      "other"
                    ]
                  },
                  "code": {
                    "enum": [
                      "Attack",
                      "Defense",
                      "Etc"
                    ]
                  },
                  "owned": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "total": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "percent": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 100
                  },
                  "worn": {
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "grade",
                          "effect",
                          "alsoGives"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "grade": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "effect": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "alsoGives": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "$ref": "../../../platform/contracts/pending.schema.json"
        }
      ]
    },
    "appearance": {
      "description": "Gear skins (equipment.skinList) and the wing skin (petwing.wingSkin), only what the data sends.",
      "type": "object",
      "required": [
        "skins",
        "wingSkin"
      ],
      "additionalProperties": false,
      "properties": {
        "skins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot",
              "slotPos",
              "itemId",
              "name",
              "icon",
              "grade"
            ],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "slotPos": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "itemId": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^https://"
              },
              "grade": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "wingSkin": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "id",
                "name",
                "icon",
                "grade"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "icon": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^https://"
                },
                "grade": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
