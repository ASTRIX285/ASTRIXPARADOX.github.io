{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/astrix-app/games/aion2/schema/atlas-layers.schema.json",
  "title": "Atreia Atlas layers",
  "description": "data/map/layers.json: the layers in panel order.",
  "type": "object",
  "required": ["layers"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "icon", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "pattern": "^/astrix-app/pages/aetherium/icons/game/[a-z0-9-]+\\.webp$", "description": "The in-game icon, cut from our own map captures." },
          "landmark": { "type": "boolean", "description": "Drawn with its name under the icon." },
          "minZoomPx": { "type": "integer", "minimum": 1, "description": "Shows only once the map is drawn at least this wide, in CSS pixels." }
        }
      }
    }
  }
}
