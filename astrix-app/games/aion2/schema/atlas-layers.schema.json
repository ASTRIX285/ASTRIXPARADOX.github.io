{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/astrix-app/games/aion2/schema/atlas-layers.schema.json",
  "title": "Atreia Atlas layers",
  "description": "data/map/layers.json: the layers in panel order.",
  "type": "object",
  "required": ["layers"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "icon", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
