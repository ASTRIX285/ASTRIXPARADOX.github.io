{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/astrix-app/games/wow-forever/schema/item-set.schema.json",
  "title": "Forever item set",
  "type": "object",
  "required": ["id", "name", "itemIds", "bonuses", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "integer" },
    "name": { "oneOf": [{ "type": "string" }, { "$ref": "pending.schema.json" }] },
    "itemIds": { "type": "array", "items": { "type": "integer" } },
    "bonuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["threshold", "spellId", "provenance"],
        "additionalProperties": false,
        "properties": {
          "threshold": { "type": "integer", "minimum": 1 },
          "spellId": { "type": "integer" },
          "provenance": { "$ref": "provenance.schema.json" }
        }
      }
    },
    "provenance": { "$ref": "provenance.schema.json" }
  }
}
