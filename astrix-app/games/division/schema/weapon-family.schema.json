{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astrixparadox.com/astrix-app/games/division/schema/weapon-family.schema.json",
  "title": "Weapon family",
  "description": "A weapon class (e.g. assault rifle) with its family bonus.",
  "type": "object",
  "$ref": "common.schema.json#/$defs/recordBase",
  "required": [],
  "properties": {
    "slotGroups": {
      "$ref": "common.schema.json#/$defs/idList"
    },
    "familyBonus": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/effect"
          }
        },
        {
          "$ref": "common.schema.json#/$defs/pending"
        }
      ]
    }
  },
  "unevaluatedProperties": false
}
